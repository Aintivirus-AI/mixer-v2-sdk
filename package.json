{
  "name": "@aintivirus-ai/mixer-sdk",
  "version": "1.0.6",
  "description": "TypeScript SDK for AintiVirus Mixer - Easy web3 integration for privacy-preserving transactions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    }
  },
  "scripts": {
    "build": "npx tsc",
    "dev": "npx tsc --watch",
    "prepublishOnly": "npm run build",
    "validate:subgraph": "tsx scripts/validate-subgraph-queries.ts",
    "test:devnet": "tsx test/test-devnet.ts",
    "dev:app": "pnpm --dir mock-frontend dev"
  },
  "keywords": [
    "web3",
    "privacy",
    "mixer",
    "zk-proof",
    "ethereum",
    "solana",
    "staking"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "buffer": "^6.0.3",
    "ethers": "^6.9.0",
    "fixed-merkle-tree": "^0.7.0",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/snarkjs": "^0.7.9",
    "dotenv": "^16.6.1",
    "graphql": "^16.12.0",
    "react": "^18.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "viem": "^2.0.0",
    "wagmi": "^2.0.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "viem": "^2.0.0",
    "wagmi": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "wagmi": {
      "optional": true
    },
    "viem": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
