# Factory contract address (required)
VITE_FACTORY_ADDRESS=0x...

# Token contract address (optional; only needed for token deposits/staking)
VITE_TOKEN_ADDRESS=0x...

# Chain ID (default: 11155111 = Sepolia)
VITE_CHAIN_ID=11155111

# RPC URL (optional; default depends on chain)
VITE_RPC_URL=https://rpc.sepolia.org

# Subgraph (optional; for Subgraph page and pool/deposit/withdrawal data)
VITE_SUBGRAPH_URL=https://gateway.thegraph.com/api/subgraphs/id/2juqPQrmSmvNGZnG2WfknCjSU5vHsi8iHgEZVvjYXKm6
# Required when using gateway.thegraph.com; get key at https://thegraph.com/studio/apikeys/
VITE_SUBGRAPH_API_KEY=f0be406e3672f9bc1ce322a9e6b07975
